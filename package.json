{
  "name": "reto-100-cims",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Reto 100 Cims: registra tus cimas, compite con tus amigos.",
  "scripts": {
    "format": "prettier --write \"index.html\" \"js/**/*.js\" \"css/estilos.css\" \"css/tema.css\" \"sw.js\" \"scripts/*.mjs\" \"tests/*.mjs\" manifest.json",
    "format:check": "prettier --check \"index.html\" \"js/**/*.js\" \"css/estilos.css\" \"css/tema.css\" \"sw.js\" \"scripts/*.mjs\" \"tests/*.mjs\" manifest.json",
    "lint": "eslint js sw.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17"
  }
}
